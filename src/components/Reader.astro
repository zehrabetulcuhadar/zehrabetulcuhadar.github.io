---
/*
  Okuma sayfası: bir yıldıza dokununca açılan yazı görünümü.
  Yazının gövdesi learning-sky deposundan gelir (src/data/sky.ts derlemede HTML'e çevirir,
  /posts/<klasör>.<dil>.json olarak yayınlanır). Mantık: src/scripts/main.ts (openReader)
*/
---

<div class="reader" id="reader" hidden role="dialog" aria-modal="true" aria-labelledby="rd-title">
  <div class="reader-scroll" id="reader-scroll" data-lenis-prevent>
    <header class="rd-bar">
      <button type="button" class="rd-back" id="rd-back">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H6M11 6l-6 6 6 6"></path></svg>
        Galaksiye dön
      </button>
      <span class="rd-crumb"><i aria-hidden="true"></i><span id="rd-planet">Basics</span></span>
      <span class="rd-prog" aria-hidden="true"><i id="rd-prog"></i></span>
    </header>

    <div class="rd-wrap">
      <aside class="rd-toc" aria-label="Bu yazıda">
        <p>Bu yazıda</p>
        <ol id="rd-toc"></ol>
      </aside>

      <article class="rd-article">
        <p class="rd-kicker"><span id="rd-kicker-planet"></span> gezegeni · <span id="rd-no"></span></p>
        <h1 id="rd-title"></h1>
        <p class="rd-meta">
          <span id="rd-date"></span><span id="rd-min"></span><span class="rd-lang"
            ><button type="button" data-rd-lang="tr" aria-label="Yazıyı Türkçe oku">TR</button> · <button
              type="button"
              data-rd-lang="en"
              aria-label="Yazıyı İngilizce oku">EN</button
            ></span
          >
        </p>
        <svg class="rd-const" viewBox="0 0 600 40" aria-hidden="true">
          <path d="M6 28 L120 10 L230 30 L352 8 L470 26 L594 12"></path>
          <g>
            <circle cx="6" cy="28" r="3"></circle><circle cx="120" cy="10" r="4.5"></circle><circle
              cx="230"
              cy="30"
              r="3"></circle><circle cx="352" cy="8" r="5"></circle><circle cx="470" cy="26" r="3"></circle><circle
              cx="594"
              cy="12"
              r="4"></circle>
          </g>
        </svg>

        <div class="rd-body" id="rd-body" aria-live="polite"></div>

        <p class="rd-tags" id="rd-tags"></p>
        <p class="rd-src">
          <a id="rd-src" href="https://github.com/zehrabetulcuhadar/learning-sky" target="_blank" rel="noopener"
            >Bu yazı ve örnek kodu GitHub'da →</a
          >
        </p>

        <nav class="rd-next" aria-label="Diğer yıldızlar">
          <button type="button" id="rd-prev"><small>← önceki yıldız</small><b>-</b></button>
          <button type="button" id="rd-nextb"><small>sonraki yıldız →</small><b>-</b></button>
        </nav>
        <p class="rd-sign">Zero ✦</p>
      </article>
    </div>
  </div>
</div>

<style is:global>
  .reader {
    --tone: #f7c548;
    --rx: 50vw;
    --ry: 50vh;
    position: fixed;
    inset: 0;
    z-index: 30;
    color: var(--fg);
    background:
      radial-gradient(60% 40% at 12% 0%, var(--blob-1), transparent 70%),
      radial-gradient(50% 40% at 100% 20%, var(--blob-2), transparent 70%),
      radial-gradient(60% 50% at 60% 100%, var(--blob-3), transparent 70%),
      linear-gradient(180deg, var(--sky-a), var(--sky-b));
    background-color: var(--bg);
    clip-path: circle(0 at var(--rx) var(--ry));
    transition: clip-path 0.75s cubic-bezier(0.6, 0, 0.2, 1);
  }
  .reader.open {
    clip-path: circle(150vmax at var(--rx) var(--ry));
  }
  .reader-scroll {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scroll-behavior: smooth;
  }
  .rd-bar {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: calc(env(safe-area-inset-top, 0px) + 12px) max(18px, env(safe-area-inset-right, 0px)) 12px
      max(18px, env(safe-area-inset-left, 0px));
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(14px);
  }
  .rd-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 700 14.5px var(--display);
    font-variation-settings: 'wdth' 88;
    color: var(--fg);
    cursor: pointer;
    padding: 9px 16px 9px 12px;
    border-radius: 999px;
    border: 1px solid var(--edge);
    background: var(--card);
    box-shadow: var(--clay-sm);
    transition: translate 0.25s var(--spring);
  }
  .rd-back:hover {
    translate: -3px 0;
  }
  .rd-back svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .rd-crumb {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 500 11px var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .rd-crumb i {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: radial-gradient(
      circle at 34% 30%,
      #fff 0 7%,
      color-mix(in srgb, var(--tone) 55%, #fff) 30%,
      var(--tone) 78%
    );
  }
  /* okuma ilerlemesi: çizgi boyunca ilerleyen bir yıldız */
  .rd-prog {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--line);
  }
  .rd-prog i {
    --p: 0;
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: calc(var(--p) * 100%);
    background: linear-gradient(90deg, transparent, var(--tone));
  }
  .rd-prog i::after {
    content: '✦';
    position: absolute;
    right: -7px;
    top: -9px;
    font-size: 15px;
    line-height: 1;
    color: var(--tone);
    filter: drop-shadow(0 0 4px var(--tone));
  }
  .rd-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 700px) minmax(0, 1fr);
    gap: 36px;
    padding: 34px max(20px, env(safe-area-inset-right, 0px)) 90px max(20px, env(safe-area-inset-left, 0px));
  }
  .rd-toc {
    justify-self: end;
    position: sticky;
    top: 96px;
    align-self: start;
    width: 190px;
    font-size: 13.5px;
  }
  .rd-toc p {
    margin: 0 0 10px;
    font: 600 22px/1 var(--hand);
    color: var(--muted);
    rotate: -3deg;
  }
  .rd-toc ol {
    list-style: none;
    margin: 0;
    padding: 0 0 0 7px;
    border-left: 1.5px dashed var(--line-strong);
    display: grid;
    gap: 2px;
  }
  .rd-toc a {
    position: relative;
    display: block;
    padding: 6px 0 6px 16px;
    color: var(--muted);
    text-decoration: none;
    transition:
      color 0.2s,
      translate 0.25s var(--spring);
  }
  .rd-toc a::before {
    content: '';
    position: absolute;
    left: -12px;
    top: 50%;
    width: 9px;
    height: 9px;
    margin-top: -4.5px;
    border-radius: 50%;
    background: var(--bg);
    border: 1.5px solid var(--line-strong);
    transition:
      background-color 0.2s,
      scale 0.3s var(--spring);
  }
  .rd-toc a:hover,
  .rd-toc a.on {
    color: var(--fg);
    translate: 3px 0;
  }
  .rd-toc a.on::before {
    background: var(--tone);
    border-color: var(--tone);
    scale: 1.3;
    box-shadow: 0 0 8px var(--tone);
  }
  .rd-article {
    grid-column: 2;
    font-size: 17.5px;
    line-height: 1.75;
  }
  .rd-article > * {
    opacity: 0;
    translate: 0 14px;
  }
  .reader.open .rd-article > * {
    opacity: 1;
    translate: 0 0;
    transition:
      opacity 0.6s ease calc(0.3s + var(--k, 0) * 0.04s),
      translate 0.7s var(--soft) calc(0.3s + var(--k, 0) * 0.04s);
  }
  .rd-kicker {
    margin: 0;
    font: 500 11.5px var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--tone) 60%, var(--fg));
  }
  .rd-article h1 {
    margin: 10px 0 14px;
    font-family: var(--display);
    font-size: clamp(32px, 5.4vw, 54px);
    line-height: 1.02;
    letter-spacing: -0.015em;
    font-variation-settings:
      'wdth' 82,
      'wght' 760;
    text-wrap: balance;
  }
  .rd-meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 8px;
    font: 500 12px var(--mono);
    color: var(--muted);
  }
  .rd-meta span {
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--chip);
    border: 1px solid var(--line);
  }
  .rd-const {
    display: block;
    width: 100%;
    margin: 22px 0 6px;
    overflow: visible;
  }
  .rd-const path {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.2;
    stroke-dasharray: 3 5;
  }
  .rd-const circle {
    fill: var(--tone);
    filter: drop-shadow(0 0 5px var(--tone));
  }
  .rd-lead {
    font-size: 21px;
    line-height: 1.6;
    font-weight: 500;
  }
  .rd-article h2 {
    margin: 46px 0 12px;
    font-family: var(--display);
    font-size: clamp(25px, 3.2vw, 32px);
    line-height: 1.1;
    font-variation-settings:
      'wdth' 84,
      'wght' 720;
    scroll-margin-top: 90px;
  }
  .rd-article h2::before {
    content: '✦';
    display: inline-block;
    margin-right: 10px;
    font-size: 0.7em;
    color: var(--tone);
    translate: 0 -3px;
  }
  .rd-article code {
    font: 500 0.86em var(--mono);
    padding: 2px 6px;
    border-radius: 6px;
    background: color-mix(in srgb, var(--tone) 20%, transparent);
  }
  .rd-article strong {
    font-weight: 750;
    background: linear-gradient(transparent 62%, color-mix(in srgb, var(--tone) 45%, transparent) 62%);
  }
  .rd-fig {
    margin: 28px 0;
    padding: 18px 14px 12px;
    border-radius: 26px;
    background: var(--card);
    border: 1px solid var(--edge);
    box-shadow: var(--clay);
  }
  .rd-fig svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .rd-fig figcaption,
  .rd-code figcaption {
    font: 500 12px var(--mono);
    color: var(--muted);
  }
  .rd-fig figcaption {
    margin-top: 8px;
    text-align: center;
  }
  .rd-article blockquote {
    margin: 26px 0;
    padding: 4px 0 4px 22px;
    border-left: 4px solid var(--tone);
    font: 500 21px/1.5 var(--display);
    font-variation-settings: 'wdth' 90;
  }
  .rd-table {
    margin: 24px 0;
    overflow-x: auto;
    border-radius: 20px;
    border: 1px solid var(--line-strong);
    background: var(--card);
  }
  .rd-table table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14.5px;
  }
  .rd-table th,
  .rd-table td {
    padding: 11px 14px;
    text-align: left;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }
  .rd-table tr:last-child > * {
    border-bottom: 0;
  }
  .rd-table thead th {
    font: 500 10.5px var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .rd-code {
    margin: 24px 0;
    border-radius: 22px;
    overflow: hidden;
    background: #1d1830;
    color: #ece6f6;
    box-shadow: var(--clay);
    --tone: #f28ac0;
  }
  .rd-code figcaption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 14px 10px 18px;
    color: #a99fc0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .rd-code button {
    font: 500 11px var(--mono);
    color: #ece6f6;
    cursor: pointer;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: none;
  }
  .rd-code button:hover {
    border-color: #f5c45e;
    color: #f5c45e;
  }
  .rd-code pre {
    margin: 0;
    padding: 16px 18px 18px;
    overflow-x: auto;
    font: 13.5px/1.7 var(--mono);
  }
  .rd-article .rd-code code {
    padding: 0;
    background: none;
    font: inherit;
  }
  .rd-tags {
    margin: 26px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font: 500 12px var(--mono);
    color: var(--muted);
  }
  .rd-next {
    margin-top: 40px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .rd-next button {
    text-align: left;
    color: var(--fg);
    cursor: pointer;
    padding: 16px 18px;
    border-radius: 22px;
    border: 1px solid var(--edge);
    background: var(--card);
    box-shadow: var(--clay-sm);
    display: grid;
    gap: 4px;
    transition: translate 0.25s var(--spring);
  }
  .rd-next button:hover {
    translate: 0 -4px;
  }
  .rd-next button:last-child {
    text-align: right;
  }
  .rd-next small {
    font: 500 10.5px var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .rd-next b {
    font: 700 16px/1.25 var(--display);
    font-variation-settings: 'wdth' 88;
  }
  .rd-next button[disabled] {
    opacity: 0.4;
    pointer-events: none;
  }
  /* ---- yazının gövdesi (Markdown'dan gelen içerik) ---- */
  .rd-lang button {
    font: inherit;
    color: inherit;
    padding: 2px 4px;
    margin: -2px 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .rd-lang button.on {
    color: var(--fg);
    font-weight: 700;
  }
  .rd-lang button:not(.on):hover {
    text-decoration: underline;
  }
  .rd-body {
    min-height: 40vh;
    transition: opacity 0.25s ease;
  }
  .rd-body.loading {
    opacity: 0.35;
  }
  .rd-by {
    margin: 0 0 18px;
    font: 500 12.5px/1.5 var(--mono);
    color: var(--muted);
  }
  .rd-by p {
    margin: 0;
  }
  .rd-body h3 {
    margin: 30px 0 8px;
    font-family: var(--display);
    font-size: 21px;
    line-height: 1.2;
    font-variation-settings:
      'wdth' 88,
      'wght' 680;
  }
  .rd-body a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--tone);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }
  .rd-body a:hover {
    background: color-mix(in srgb, var(--tone) 22%, transparent);
  }
  .rd-body ul,
  .rd-body ol {
    margin: 14px 0;
    padding-left: 1.5em;
  }
  .rd-body li {
    margin: 8px 0;
  }
  .rd-body li::marker {
    color: color-mix(in srgb, var(--tone) 70%, var(--fg));
    font-weight: 700;
  }
  .rd-body li > p {
    margin: 8px 0;
  }
  .rd-body strong {
    background: none;
    font-weight: 720;
  }
  .rd-body .rd-lead strong:first-child {
    background: linear-gradient(transparent 62%, color-mix(in srgb, var(--tone) 45%, transparent) 62%);
  }
  .rd-body blockquote {
    font: inherit;
    color: var(--muted);
  }
  .rd-body blockquote p {
    margin: 6px 0;
  }
  .rd-body hr {
    margin: 34px 0;
    border: 0;
    border-top: 1px dashed var(--line-strong);
  }
  .rd-body img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
  }
  .rd-img svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .rd-body .rd-table td,
  .rd-body .rd-table th {
    white-space: normal;
    vertical-align: top;
  }
  .rd-body .rd-table code {
    overflow-wrap: anywhere;
  }
  .rd-code pre span {
    color: var(--shiki-dark);
  }
  .rd-code figcaption span:empty::before {
    content: '</>';
  }
  /* uzun satır içi kodlar ve adresler telefonda satıra sığsın */
  .rd-body {
    overflow-wrap: break-word;
  }
  .rd-body :not(pre) > code {
    overflow-wrap: anywhere;
    white-space: normal;
  }
  .rd-body .rd-lead {
    font-size: 19px;
    font-weight: 450;
  }
  @media (max-width: 620px) {
    .rd-body .rd-lead {
      font-size: 17px;
    }
    .rd-body ul,
    .rd-body ol {
      padding-left: 1.15em;
    }
  }
  .rd-src {
    margin: 26px 0 0;
    font: 500 13px var(--mono);
  }
  .rd-src a {
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px dashed var(--line-strong);
  }
  .rd-src a:hover {
    color: var(--fg);
  }
  .rd-sign {
    margin: 34px 0 0;
    text-align: center;
    font: 600 30px/1 var(--hand);
    color: var(--star);
  }
  @media (max-width: 1080px) {
    .rd-wrap {
      grid-template-columns: minmax(0, 700px);
      justify-content: center;
    }
    .rd-toc {
      display: none;
    }
    .rd-article {
      grid-column: 1;
    }
  }
  @media (max-width: 620px) {
    .rd-article {
      font-size: 16.5px;
    }
    .rd-lead {
      font-size: 18.5px;
    }
    .rd-crumb {
      display: none;
    }
    .rd-next {
      grid-template-columns: 1fr;
    }
    .rd-next button:last-child {
      text-align: left;
    }
    .rd-wrap {
      padding-top: 22px;
    }
    /* telefonda tablo ve kod yana kaymadan sığar, şema okunacak boyda kalıp kendi içinde kayar */
    .rd-table table {
      font-size: 13.5px;
    }
    .rd-table th,
    .rd-table td {
      padding: 10px 10px;
      white-space: normal;
    }
    .rd-code pre {
      padding: 14px 14px 16px;
      font-size: 12.5px;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }
    .rd-fig {
      overflow-x: auto;
      overscroll-behavior-x: contain;
    }
    .rd-fig svg {
      min-width: 470px;
    }
    .rd-fig figcaption {
      position: sticky;
      left: 0;
    }
  }
</style>
