---
import Base from '../layouts/Base.astro';
---

<Base title="Kayıp gezegen · Learning Galaxy by Zero" description="Aradığın sayfa bu galakside yok.">
  <main class="lost">
    <div class="planet" aria-hidden="true"><i></i><i></i><b>?</b></div>
    <p class="eyebrow">404</p>
    <h1>Bu gezegen henüz keşfedilmedi.</h1>
    <p>Aradığın sayfa bu galakside yok ya da başka bir yörüngeye taşındı.</p>
    <a class="back" href="/">Galaksiye dön</a>
  </main>
</Base>

<style>
  .lost {
    min-height: 100svh;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 10px;
    padding: 24px;
    text-align: center;
    color: var(--fg);
    background:
      radial-gradient(60% 40% at 12% 0%, var(--blob-1), transparent 70%),
      radial-gradient(60% 50% at 60% 100%, var(--blob-3), transparent 70%),
      linear-gradient(180deg, var(--sky-a), var(--sky-b));
  }
  .planet {
    position: relative;
    width: 132px;
    height: 132px;
    margin-bottom: 14px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: radial-gradient(circle at 34% 30%, #f7a8cf, #e0709f 58%, #b94f7f);
    box-shadow:
      0 24px 34px -16px rgba(120, 50, 90, 0.5),
      inset 0 -8px 14px rgba(120, 40, 80, 0.3);
    animation: bob 4s ease-in-out infinite;
  }
  .planet b {
    font: 800 64px/1 var(--display);
    color: #fff;
  }
  .planet i {
    position: absolute;
    inset: 46% -26% auto;
    height: 26px;
    border-radius: 50%;
    border: 5px solid #f5c45e;
    rotate: -16deg;
    clip-path: inset(50% 0 0 0);
  }
  .planet i:first-child {
    clip-path: inset(0 0 50% 0);
    z-index: -1;
  }
  .eyebrow {
    margin: 0;
    font: 500 12px var(--mono);
    letter-spacing: 0.2em;
    color: var(--muted);
  }
  h1 {
    margin: 0;
    font: 760 clamp(28px, 6vw, 46px) / 1.05 var(--display);
    font-variation-settings: 'wdth' 84;
    text-wrap: balance;
  }
  p {
    margin: 0;
    max-width: 34ch;
    color: var(--muted);
  }
  .back {
    margin-top: 16px;
    padding: 14px 24px;
    border-radius: 20px;
    font: 700 16px var(--display);
    text-decoration: none;
    color: var(--accent-fg);
    background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 86%, #fff), var(--accent));
    box-shadow:
      0 7px 0 -1px color-mix(in srgb, var(--accent) 62%, #20081a),
      0 22px 30px -14px var(--accent),
      inset 0 2px 0 rgba(255, 255, 255, 0.4);
    transition: translate 0.3s;
  }
  .back:hover {
    translate: 0 -2px;
  }
  .back:active {
    translate: 0 5px;
  }
  @keyframes bob {
    50% {
      translate: 0 -10px;
      rotate: 4deg;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .planet {
      animation: none;
    }
  }
</style>
