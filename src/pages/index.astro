---
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import Reader from '../components/Reader.astro';
import '../styles/round3.css';
import '../styles/intro-ide.css';
import '../styles/ui.css';
import '../styles/theme-switch.css';
import { experience, skills, links, badgeColors, sections } from '../data/site';
import { loadSky, skyIndex } from '../data/sky';

// Yazı listesi learning-sky deposundan gelir; sayfaya küçük bir JSON olarak gömülür.
const skyJson = JSON.stringify(skyIndex(await loadSky())).replace(/</g, '\\u003c');

const pastel = (hex: string, a = 0.5) => {
  const n = parseInt(hex.slice(1), 16);
  const mix = (c: number) => Math.round(c + (255 - c) * a);
  return `rgb(${mix(n >> 16)}, ${mix((n >> 8) & 255)}, ${mix(n & 255)})`;
};
let k = 0;
const badge = (label: string) => {
  const c = badgeColors[k++ % badgeColors.length];
  const tilt = ((k % 5) - 2) * 1.6;
  return { label, c, bg: pastel(c, 0.55), tilt };
};
const scopeTargets = sections.slice(1);
/** Her bölümün kendi rengi: o bölümün gezegeninden gelir, sadece küçük vurgularda kullanılır. */
const tones = ['#C2577E', '#F2766B', '#F7C548', '#7C8CF2', '#4FC7B8'];
---

<Base
  title="Zehra Betül Çuhadar · Galaksim"
  description="Yazılım geliştirme uzmanı Zehra'nın kişisel sitesi. Öğrendiği her konu bir yıldız, her başlık bir gezegen."
>
  <script type="application/json" id="sky-data" set:html={skyJson} />
  <Intro />
  <canvas id="galaxy" aria-hidden="true"></canvas>
  <div id="labels" class="labels" aria-hidden="true"></div>

  <header class="top">
    <a class="brand" href="#giris" data-goto="0"
      >Learning <span>Galaxy</span> <em class="nick" title="Lakabım">by Zero</em></a
    >
    <div class="top-actions">
      <button class="lang" id="lang" type="button" aria-label="Dil / Language">
        <span class="ln-orbit" aria-hidden="true"></span>
        <span class="ln-moon"><span><b id="lg-other">EN</b></span></span>
        <span class="ln-planet"><b id="lg-cur">TR</b></span>
      </button>
      <button class="theme" id="theme" type="button" aria-label="Gece ve gündüz arasında geç">
        <span class="ts-scene" id="theme-scene" aria-hidden="true"></span>
      </button>
    </div>
  </header>

  <!-- Gözlemevi: sağ altta bir teleskop. Tıklayınca döner, göz merceğinden içeri bakarız:
       karanlık mercekten açılır, ortada galaksinin canlı, yakınlaştırılmış görüntüsü belirir. -->
  <button
    class="telescope"
    id="telescope"
    type="button"
    aria-expanded="false"
    aria-controls="scope"
    aria-label="Gözlemevi: teleskoptan bak"
  >
    <svg viewBox="0 0 120 120" aria-hidden="true">
      <defs>
        <linearGradient id="tl-tube" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" style="stop-color: var(--tl-a)"></stop>
          <stop offset="1" style="stop-color: var(--tl-b)"></stop>
        </linearGradient>
      </defs>
      <path class="tl-legs" d="M60 70 L30 114 M60 70 L90 114 M60 70 L60 117"></path>
      <path class="tl-tray" d="M44 94 L76 94"></path>
      <g class="tl-aim">
        <g class="tl-sway">
          <g class="tl-turn">
            <rect x="40" y="43" width="22" height="6" rx="3" class="tl-finder"></rect>
            <rect x="20" y="50" width="70" height="17" rx="8.5" fill="url(#tl-tube)"></rect>
            <rect x="34" y="50" width="5" height="17" class="tl-band"></rect>
            <rect x="84" y="46" width="17" height="25" rx="5" class="tl-shield"></rect>
            <ellipse cx="101" cy="58.5" rx="2.6" ry="10" class="tl-glass"></ellipse>
            <rect x="9" y="53.5" width="13" height="10" rx="3" class="tl-eyepiece"></rect>
          </g>
          <circle cx="9" cy="58.5" r="7.5" class="tl-rim"></circle>
          <circle cx="9" cy="58.5" r="4.6" class="tl-glassy"></circle>
          <circle cx="9" cy="58.5" r="2.4" class="tl-eye" id="tl-eye"></circle>
        </g>
      </g>
      <circle cx="60" cy="68" r="5" class="tl-mount"></circle>
      <path class="tl-spark" d="M108 22 l2 6 l6 2 l-6 2 l-2 6 l-2 -6 l-6 -2 l6 -2 z"></path>
    </svg>
    <span>Gözlemevi</span>
  </button>

  <div class="scope" id="scope" hidden>
    <canvas class="scope-3d" id="scope3d" aria-hidden="true"></canvas>
    <div class="scope-ring" id="scope-ring" aria-hidden="true"></div>
    <div class="scope-rim" aria-hidden="true"></div>
    <i class="scope-mark" aria-hidden="true"></i>
    <div class="scope-lens" id="lens">
      <div class="focus"></div>
      <div class="reticle" aria-hidden="true"></div>
    </div>
    <div class="scope-info">
      <small id="scope-kind">Gezegen</small>
      <b id="scope-name" aria-live="polite">Hakkımda</b>
      <div class="scope-acts">
        <button type="button" id="scope-prev" aria-label="Önceki gezegen">‹</button>
        <button type="button" id="scope-go" class="scope-go">Yakından incele</button>
        <button type="button" id="scope-next" aria-label="Sonraki gezegen">›</button>
      </div>
      <p class="scope-hint">
        <span class="mouse">Halkayı çevir ya da ← → ile gezegenler arasında dolaş</span>
        <span class="touch">Halkayı parmağınla çevir, gezegenler arasında dolaş</span>
      </p>
    </div>
    <button type="button" class="scope-x" id="scope-x" aria-label="Gözlemevini kapat">×</button>
  </div>

  <main id="main">
    <section id="giris" style={`--tone:${tones[0]}`} data-sec="0" aria-label="Karşılama">
      <div class="hero">
        <h1 class="kinetic" id="kinetic" aria-label="Merhaba, ben Zehra.">
          <span class="word" data-part="Merhaba,"></span>
          <span class="word name" data-part="ben Zehra."></span>
        </h1>
        <p class="sub">Galaksime hoş geldin.</p>
        <div class="hero-row">
          <button class="cta" type="button" data-goto="1"
            >Keşfet <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></button
          >
          <button class="cta ghost" type="button" data-explore
            ><svg viewBox="0 0 24 24" aria-hidden="true"
              ><circle cx="12" cy="12" r="9"></circle><path d="M15.5 8.5l-2 5-5 2 2-5z"></path></svg
            >Galakside gez</button
          >
          <span class="hint"><i aria-hidden="true"></i>ya da aşağı kaydır</span>
        </div>
        <p class="note" aria-hidden="true">
          <svg viewBox="0 0 70 46"><path d="M4 40 C 18 44, 40 38, 58 10 M58 10 l-11 3 M58 10 l1 12"></path></svg>
          gezegenlere dokunabilirsin
        </p>
      </div>
    </section>

    <section id="hakkimda" style={`--tone:${tones[1]}`} data-sec="1" aria-labelledby="h-about">
      <article class="panel left">
        <span class="tape" aria-hidden="true"></span>
        <div class="panel-in">
          <p class="eyebrow">Hakkımda</p>
          <h2 id="h-about">Yazılım geliştirme uzmanıyım.</h2>
          <p>Kendimi geliştirmeye devam ediyorum; öğrendikçe galaksimi büyütüyorum.</p>
          <ol class="jobs">
            {
              experience.map((job) => (
                <li class="job">
                  <strong>
                    {job.company} · {job.role}
                  </strong>
                  <small>{job.meta}</small>
                  <div class="badges">
                    {job.skills.map((s) => {
                      const b = badge(s);
                      return (
                        <span class="badge" style={`--c:${b.c};--bb:${b.bg};--tilt:${b.tilt}deg`}>
                          {b.label}
                        </span>
                      );
                    })}
                  </div>
                </li>
              ))
            }
          </ol>
          <p class="group">Ön uç</p>
          <div class="badges">
            {
              skills.front.map((s) => {
                const b = badge(s);
                return (
                  <span class="badge" style={`--c:${b.c};--bb:${b.bg};--tilt:${b.tilt}deg`}>
                    {b.label}
                  </span>
                );
              })
            }
          </div>
          <p class="group">Arka uç ve veri</p>
          <div class="badges">
            {
              skills.back.map((s) => {
                const b = badge(s);
                return (
                  <span class="badge" style={`--c:${b.c};--bb:${b.bg};--tilt:${b.tilt}deg`}>
                    {b.label}
                  </span>
                );
              })
            }
          </div>
        </div>
      </article>
    </section>

    <section id="gelisim" style={`--tone:${tones[2]}`} data-sec="2" aria-labelledby="h-growth">
      <article class="panel left">
        <span class="tape" aria-hidden="true"></span>
        <div class="panel-in">
          <p class="eyebrow">Gelişim alanım</p>
          <h2 id="h-growth">Altında ne var?</h2>
          <p>
            İşimde kullandığım teknolojilerin altında ne olduğunu da bilmek istiyorum. İşlemciden işletim sistemine,
            ağdan veritabanına, oradan yazılım mimarisine kadar...
          </p>
          <p>
            Yapay zekâ artık kodun büyük kısmını yazabiliyor. Bu yüzden doğru soruyu sormak ve cevabı denetleyebilmek
            her zamankinden daha değerli; bu da işin altındakini ne kadar iyi bildiğime bağlı. Ben de bu alanı kişisel
            oyun parkım gibi kullanmaya karar verdim.
          </p>
          <p>
            Öğrendiğim her konuyu kısa bir yazıya dönüştürüyorum. Her yazı bu gökyüzünde bir yıldız, her konu bir
            gezegen. Burası beni motive eden, gelişme hevesimi canlı tutan notlarımın yeri; herkese açık bir not
            defteri.
          </p>
        </div>
      </article>
    </section>

    <section id="gokyuzu" style={`--tone:${tones[3]}`} data-sec="3" aria-labelledby="h-sky">
      <div class="skyhead">
        <p class="eyebrow">Gökyüzüm</p>
        <h2 id="h-sky">Galaksimi büyütmeye devam ediyorum.</h2>
        <p>Her yıldız bir yazı. Bir gezegene dokun, yakından bak; bir yıldıza dokun, yazıyı oku.</p>
        <button class="cta ghost small" type="button" data-explore
          ><svg viewBox="0 0 24 24" aria-hidden="true"
            ><circle cx="12" cy="12" r="9"></circle><path d="M15.5 8.5l-2 5-5 2 2-5z"></path></svg
          >Galakside serbest gez</button
        >
        <ul class="legend" aria-hidden="true">
          <li><i class="lg-planet"></i>gezegen = konu</li>
          <li><i class="lg-star"></i>yıldız = yazı</li>
        </ul>
        <!-- Son yazılar ve konular: main.ts doldurur (yazılar learning-sky'dan gelir) -->
        <div class="sky-latest" id="sky-latest" hidden>
          <p class="sky-h">Son yıldızlar</p>
          <div id="sky-latest-list"></div>
        </div>
        <div class="sky-topics" id="sky-topics" hidden></div>
      </div>
    </section>

    <section id="iletisim" style={`--tone:${tones[4]}`} data-sec="4" aria-labelledby="h-contact">
      <article class="panel left">
        <span class="tape" aria-hidden="true"></span>
        <div class="panel-in">
          <p class="eyebrow">Bana ulaşın</p>
          <h2 id="h-contact">Merhaba demek ister misin?</h2>
          <p>
            Bir yazı hakkında söylemek istediğin bir şey mi var, ya da sadece merhaba mı demek istiyorsun? Buradayım.
            Gelişim önerilerine de her zaman açığım.
          </p>
          <div class="links">
            {
              links.map((l) => (
                <a href={l.url} target="_blank" rel="noopener">
                  <i aria-hidden="true" class={`ico-${l.name.toLowerCase()}`}>
                    {l.name === 'LinkedIn' && (
                      <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M6.6 9.4H3.4v10.2h3.2zM5 4.3a1.85 1.85 0 1 0 0 3.7 1.85 1.85 0 0 0 0-3.7zM20.6 13.7c0-3.1-1.65-4.55-3.86-4.55-1.78 0-2.57.98-3.02 1.67V9.4h-3.2v10.2h3.2v-5.7c0-1.5.72-2.36 1.9-2.36 1.14 0 1.78.8 1.78 2.36v5.7h3.2z" />
                      </svg>
                    )}
                    {l.name === 'GitHub' && (
                      <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                      </svg>
                    )}
                    {l.name === 'Instagram' && (
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                      >
                        <rect x="3" y="3" width="18" height="18" rx="5.5" />
                        <circle cx="12" cy="12" r="4.2" />
                        <circle cx="17.3" cy="6.7" r="0.6" fill="currentColor" />
                      </svg>
                    )}
                  </i>
                  <b>{l.name}</b> <span>{l.handle}</span>
                  <em aria-hidden="true">↗</em>
                </a>
              ))
            }
          </div>
          <p class="foot">Zehra tarafından, öğrenilirken yazılıyor ✦</p>
          <p class="replay">
            Açılışı yeniden izle:
            <button type="button" data-replay="ide">kod</button>
            <button type="button" data-replay="term">terminal</button>
            <button type="button" data-replay="bomb">bomba</button>
          </p>
        </div>
      </article>
    </section>
  </main>

  <nav class="rail" id="rail" aria-label="Bölümler">
    {
      sections.map((s, i) => (
        <a href={`#${s.id}`} data-goto={i} data-rail={i} style={`--tone:${tones[i]}`}>
          <i aria-hidden="true" />
          <span>{s.label}</span>
        </a>
      ))
    }
  </nav>

  <aside class="drawer" id="drawer" aria-live="polite" aria-label="Gezegenin yazıları">
    <button class="close" id="drawer-close" type="button" aria-label="Kapat">✕</button>
    <div id="drawer-body"></div>
    <div class="insp-nav">
      <button type="button" id="insp-prev" aria-label="Önceki gezegen">‹</button>
      <span id="insp-count" aria-live="polite">1 / 15</span>
      <button type="button" id="insp-next" aria-label="Sonraki gezegen">›</button>
      <button type="button" id="insp-poke" class="poke">Canlandır ✦</button>
    </div>
    <p class="insp-hint">
      <span class="mouse">sürükle: çevir · tekerlek: yakınlaş · ← →: sıradaki</span>
      <span class="touch">sürükle: çevir · iki parmak: yakınlaş</span>
    </p>
  </aside>

  <!-- Sayfanın kendi kaydırma çubuğu: bölümler arasında gezen küçük bir gezegen -->
  <div class="pagebar" id="pagebar" aria-hidden="true">
    <i class="pb-track"></i>
    {tones.map((t, i) => <i class="pb-dot" style={`--i:${i};--tone:${t}`} />)}
    <i class="pb-thumb" id="pb-thumb"></i>
  </div>

  <!-- Serbest gezinti: galakside sürükleyerek dolaşma -->
  <div class="hud" id="hud" hidden>
    <div class="hud-top">
      <span class="hud-title"><i aria-hidden="true">✦</i> Serbest gezinti</span>
      <button type="button" id="hud-x">Bitir <span aria-hidden="true">✕</span></button>
    </div>
    <div class="hud-zoom">
      <button type="button" id="hud-in" aria-label="Yakınlaş">+</button>
      <button type="button" id="hud-out" aria-label="Uzaklaş">−</button>
      <button type="button" id="hud-home" aria-label="Galaksinin tamamını göster">
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><circle cx="12" cy="12" r="3"></circle><ellipse cx="12" cy="12" rx="10" ry="4.5"></ellipse></svg
        >
      </button>
    </div>
    <div class="hud-bottom">
      <p class="hud-hint">
        <span class="mouse">sürükle: kaydır · tekerlek: yakınlaş · gezegene ya da yıldıza tıkla</span>
        <span class="touch">sürükle: kaydır · iki parmak: yakınlaş · gezegene ya da yıldıza dokun</span>
      </p>
      <div class="hud-chips" id="hud-chips"></div>
    </div>
  </div>

  <Reader />

  <noscript><p class="noscript">Galaksi JavaScript ile çiziliyor; metinler yine de okunabilir.</p></noscript>
</Base>

<script>
  import '../scripts/main';
</script>

<style>
  #galaxy {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 0;
    touch-action: pan-y;
  }
  .labels {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }

  /* ---------- üst bar ---------- */
  .top {
    position: fixed;
    z-index: 10;
    top: calc(env(safe-area-inset-top, 0px) + 16px);
    left: max(22px, env(safe-area-inset-left, 0px));
    right: max(22px, env(safe-area-inset-right, 0px));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .brand {
    font-family: var(--display);
    font-weight: 700;
    font-size: 18px;
    font-variation-settings: 'wdth' 85;
    text-decoration: none;
    padding: 8px 14px 8px 12px;
    border-radius: 999px;
    background: var(--chip);
    border: 1px solid var(--edge);
    box-shadow: var(--clay-sm);
    backdrop-filter: blur(12px);
  }
  .brand span {
    color: var(--accent);
  }
  .nick {
    display: inline-block;
    margin-left: 4px;
    font: 600 21px/1 var(--hand);
    font-style: normal;
    color: var(--star);
    transform: rotate(-6deg) translateY(-1px);
    transition: transform 0.45s var(--spring);
  }
  .brand:hover .nick {
    transform: rotate(4deg) translateY(-3px) scale(1.12);
  }
  .top-actions {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  /* gözlemevi: sağ alttaki teleskop */
  .telescope {
    --tl-a: #e48aae;
    --tl-b: #b84d76;
    position: fixed;
    z-index: 10;
    right: max(18px, env(safe-area-inset-right, 0px));
    bottom: calc(env(safe-area-inset-bottom, 0px) + 14px);
    width: 116px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    color: var(--fg);
    display: grid;
    justify-items: center;
  }
  :global([data-theme='night']) .telescope {
    --tl-a: #f7a8cf;
    --tl-b: #d9649b;
  }
  .telescope svg {
    width: 116px;
    height: 116px;
    overflow: visible;
    filter: drop-shadow(0 10px 14px rgba(60, 30, 80, 0.25));
  }
  .telescope span {
    font: 500 11px var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: -6px;
    transition: color 0.2s;
  }
  .telescope:hover span,
  .telescope:focus-visible span {
    color: var(--accent);
  }
  .tl-legs,
  .tl-tray {
    stroke: var(--fg);
    stroke-width: 3;
    stroke-linecap: round;
    fill: none;
    opacity: 0.8;
  }
  .tl-tray {
    stroke-width: 2;
    opacity: 0.45;
  }
  .tl-mount,
  .tl-finder,
  .tl-eyepiece {
    fill: var(--fg);
  }
  .tl-finder,
  .tl-eyepiece {
    opacity: 0.85;
  }
  .tl-band,
  .tl-shield,
  .tl-eye {
    fill: var(--star);
  }
  .tl-glass {
    fill: #bff3ff;
    opacity: 0.9;
  }
  .tl-spark {
    fill: var(--star);
    transform-box: fill-box;
    transform-origin: center;
    animation: twinkle 2.6s ease-in-out infinite;
  }
  @keyframes twinkle {
    0%,
    100% {
      scale: 0.6;
      opacity: 0.4;
    }
    50% {
      scale: 1.1;
      opacity: 1;
    }
  }
  .tl-aim {
    transform-origin: 60px 64px;
    rotate: -26deg;
    transition: rotate 0.55s cubic-bezier(0.5, 1.5, 0.45, 1);
  }
  .tl-sway {
    transform-origin: 60px 64px;
    animation: sway 6s ease-in-out infinite;
  }
  @keyframes sway {
    0%,
    100% {
      rotate: -2deg;
    }
    50% {
      rotate: 2deg;
    }
  }
  .telescope:hover .tl-aim {
    rotate: -34deg;
  }
  /* göz merceği: açılış buradan başlar */
  .tl-rim,
  .tl-glassy {
    display: none;
  }
  :global(.scoping) .telescope,
  :global(.inspecting) .telescope {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  /* ---------- bölümler ---------- */
  :global(.scoping) main,
  :global(.scoping) .rail,
  :global(.inspecting) main,
  :global(.inspecting) .rail,
  :global(.exploring) main,
  :global(.exploring) .rail,
  :global(.exploring) .telescope,
  :global(.reading) .telescope,
  :global(.intro) main,
  :global(.intro) .top,
  :global(.intro) .telescope,
  :global(.intro) .rail,
  :global(.flying) main {
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  main,
  .top,
  .telescope,
  .rail {
    transition: opacity 0.9s ease 0.1s;
  }
  main {
    position: relative;
    z-index: 3;
    pointer-events: none;
  }
  :global(.inspecting) main :global(*),
  :global(.exploring) main :global(*),
  :global(.exploring) .rail,
  :global(.exploring) .telescope,
  :global(.scoping) main :global(*),
  :global(.inspecting) .rail,
  :global(.scoping) .rail {
    pointer-events: none !important;
  }
  :global(.locked) #galaxy {
    touch-action: none;
  }
  :global(.inspecting) #galaxy {
    cursor: grab;
  }
  :global(.inspecting) #galaxy:active {
    cursor: grabbing;
  }
  section {
    position: relative;
    height: 100vh;
    height: 100svh;
    padding-inline: var(--gutter) max(16px, env(safe-area-inset-right, 0px));
  }
  .eyebrow {
    display: inline-block;
    margin: 0;
    padding: 4px 10px 3px;
    border-radius: 8px;
    font-family: var(--mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-fixed);
    background: color-mix(in srgb, var(--tone) 42%, #fff);
    border: 1.5px solid color-mix(in srgb, var(--tone) 70%, #fff);
    rotate: -2deg;
    box-shadow: 0 4px 8px -5px color-mix(in srgb, var(--tone) 80%, #402040);
  }
  :global([data-theme='night']) .eyebrow {
    color: var(--fg);
    background: color-mix(in srgb, var(--tone) 22%, transparent);
    border-color: color-mix(in srgb, var(--tone) 55%, transparent);
    box-shadow: none;
  }
  h2 {
    font-family: var(--display);
    font-size: clamp(29px, 3.4vw, 40px);
    line-height: 1.02;
    letter-spacing: -0.01em;
    margin: 14px 0 12px;
    font-variation-settings:
      'wdth' 82,
      'wght' 720;
    text-wrap: balance;
  }

  /* ---------- karşılama ---------- */
  .hero {
    position: absolute;
    left: max(28px, env(safe-area-inset-left, 0px));
    bottom: 12vh;
    display: grid;
    gap: 10px;
    justify-items: start;
  }
  /* yazının arkası hafif buğulu: arkadan geçen gezegenler yazıyı bölmez, flu bir renk lekesi olur */
  .hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -70px -120px -60px -60px;
    backdrop-filter: blur(9px);
    background: radial-gradient(closest-side, color-mix(in srgb, var(--bg) 62%, transparent), transparent);
    -webkit-mask: radial-gradient(closest-side, #000 52%, transparent);
    mask: radial-gradient(closest-side, #000 52%, transparent);
    pointer-events: none;
  }
  .kinetic {
    margin: 0;
    display: grid;
    font-family: var(--display);
    font-size: clamp(44px, min(8vw, 17vh), 118px);
    line-height: 0.88;
    letter-spacing: -0.025em;
    pointer-events: auto;
  }
  .kinetic .word {
    display: block;
    white-space: nowrap;
  }
  .kinetic :global(.ch) {
    display: inline-block;
    font-variation-settings:
      'wght' 740,
      'wdth' 96,
      'opsz' 96;
    transform-origin: 50% 80%;
    will-change: transform;
    /* yaklaştıkça harf yıldız rengine döner */
    color: color-mix(in srgb, currentColor calc(100% - var(--f, 0) * 70%), var(--star));
  }
  .kinetic .name {
    color: var(--accent);
  }
  /* açılış bitince harfler sırayla, yaylanarak yerine oturur */
  :global(.anim) .kinetic :global(.ch) {
    animation: rise 1s var(--spring) both;
    animation-delay: calc(var(--n) * 38ms + 120ms);
  }
  :global(.anim.intro) .kinetic :global(.ch) {
    animation: none;
    opacity: 0;
  }
  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 0.55em;
      rotate: 9deg;
    }
  }
  .sub {
    margin: 4px 0 0;
    font-size: clamp(19px, 2.1vw, 26px);
    color: var(--muted);
  }
  .hero-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 12px;
  }
  .cta {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 700 17px var(--display);
    padding: 15px 22px 15px 26px;
    border-radius: 20px;
    cursor: pointer;
    color: var(--accent-fg);
    background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 86%, #fff), var(--accent));
    border: 0;
    box-shadow:
      0 7px 0 -1px color-mix(in srgb, var(--accent) 62%, #20081a),
      0 22px 30px -14px var(--accent),
      inset 0 2px 0 rgba(255, 255, 255, 0.4);
    transition:
      translate 0.25s var(--spring),
      box-shadow 0.25s ease;
  }
  .cta svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 0.35s var(--spring);
  }
  .cta:hover {
    translate: 0 -2px;
  }
  .cta:hover svg {
    translate: 5px 0;
  }
  .cta:active {
    translate: 0 5px;
    box-shadow:
      0 2px 0 -1px color-mix(in srgb, var(--accent) 62%, #20081a),
      0 10px 16px -10px var(--accent),
      inset 0 2px 0 rgba(255, 255, 255, 0.4);
  }
  .hint {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
  }
  .hint i {
    width: 16px;
    height: 26px;
    border-radius: 9px;
    border: 1.5px solid currentColor;
    position: relative;
    opacity: 0.8;
  }
  .hint i::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 5px;
    width: 3px;
    height: 6px;
    margin-left: -1.5px;
    border-radius: 2px;
    background: var(--accent);
    animation: wheel 1.8s cubic-bezier(0.5, 0, 0.3, 1) infinite;
  }
  @keyframes wheel {
    0% {
      translate: 0 0;
      opacity: 0;
    }
    25% {
      opacity: 1;
    }
    80%,
    100% {
      translate: 0 9px;
      opacity: 0;
    }
  }
  .note {
    position: absolute;
    left: max(330px, 39vw);
    bottom: 150px;
    margin: 0;
    font: 600 22px/1 var(--hand);
    color: var(--muted);
    rotate: -5deg;
    white-space: nowrap;
    /* gece modunda yörünge çizgilerinin ve yıldızların üstünde de okunsun */
    text-shadow:
      0 0 10px var(--bg),
      0 0 20px var(--bg);
  }
  :global([data-theme='night']) .note {
    color: color-mix(in srgb, var(--fg) 82%, transparent);
  }
  .note svg {
    position: absolute;
    left: 100%;
    bottom: 60%;
    width: 70px;
    height: 46px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.75;
  }

  /* ---------- kil kartlar ---------- */
  .panel {
    pointer-events: auto;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: min(456px, calc(100% - 32px));
    color: var(--fg);
    background: var(--card);
    border: 1.5px solid var(--edge);
    border-radius: 32px;
    backdrop-filter: blur(18px) saturate(1.15);
    box-shadow: var(--clay);
  }
  .panel-in {
    max-height: min(calc(100svh - 196px), 780px);
    overflow: auto;
    padding: 30px 26px 30px;
    /* alt kenarda içerik yumuşakça kaybolur: devamı olduğunu belli eder */
    -webkit-mask: linear-gradient(#000 calc(100% - 26px), transparent);
    mask: linear-gradient(#000 calc(100% - 26px), transparent);
    border-radius: inherit;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--tone) 60%, transparent) transparent;
  }
  /* kartı tutan renkli bant: her bölümde o bölümün gezegeninin renginde */
  .tape {
    position: absolute;
    z-index: 1;
    top: -13px;
    left: 44px;
    width: 92px;
    height: 26px;
    rotate: -4deg;
    background:
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.28) 0 6px, transparent 6px 12px),
      color-mix(in srgb, var(--tone) 78%, #fff);
    opacity: 0.92;
    box-shadow: 0 4px 8px -4px rgba(60, 30, 80, 0.4);
    clip-path: polygon(0 0, 100% 0, 96% 25%, 100% 50%, 96% 75%, 100% 100%, 0 100%, 4% 75%, 0 50%, 4% 25%);
  }
  .panel.right .tape {
    left: auto;
    right: 48px;
    rotate: 3deg;
  }
  .panel.right {
    right: max(34px, env(safe-area-inset-right, 0px));
  }
  .panel.left {
    left: max(34px, env(safe-area-inset-left, 0px));
  }
  .panel p {
    margin: 0 0 10px;
  }
  .panel p.eyebrow {
    margin: 0;
  }
  .jobs {
    list-style: none;
    margin: 14px 0 0;
    padding: 0 0 0 20px;
    display: grid;
    gap: 8px;
    position: relative;
  }
  /* zaman çizgisi: noktalı bir yörünge */
  .jobs::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 14px;
    bottom: 14px;
    border-left: 2px dotted color-mix(in srgb, var(--tone) 70%, var(--muted));
  }
  .job {
    position: relative;
    padding: 11px 14px 12px;
    border-radius: 18px;
    background: var(--inset);
    border: 1px solid var(--line);
    box-shadow: inset 0 1px 0 var(--hi);
    transition:
      translate 0.3s var(--spring),
      border-color 0.3s;
  }
  .job:hover {
    translate: 3px 0;
    border-color: color-mix(in srgb, var(--tone) 60%, transparent);
  }
  .job::before {
    content: '';
    position: absolute;
    left: -21px;
    top: 17px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--card-solid);
    border: 2.5px solid var(--tone);
  }
  .job:first-child::before {
    background: var(--tone);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--tone) 60%, transparent);
    animation: now 2.4s ease-out infinite;
  }
  @keyframes now {
    to {
      box-shadow: 0 0 0 9px transparent;
    }
  }
  .job strong {
    display: block;
    font-size: 14.5px;
    line-height: 1.3;
  }
  .job small {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 7px 6px;
    margin-top: 9px;
  }
  .badge {
    font-family: var(--hand);
    font-size: 18px;
    line-height: 1.1;
    padding: 2px 10px;
    border-radius: 9px;
    background: var(--bb);
    color: var(--ink-fixed);
    border: 2px solid var(--badge-border);
    rotate: var(--tilt);
    box-shadow: 0 5px 10px -6px rgba(60, 30, 80, 0.5);
    transition:
      rotate 0.35s var(--spring),
      scale 0.35s var(--spring);
  }
  :global([data-theme='night']) .badge {
    background: color-mix(in srgb, var(--c) 20%, transparent);
    color: var(--fg);
    border-color: color-mix(in srgb, var(--c) 55%, transparent);
    box-shadow: none;
  }
  .badge:hover {
    rotate: 0deg;
    scale: 1.1;
  }
  .group {
    margin: 14px 0 0 !important;
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .group::after {
    content: '';
    flex: 1;
    border-top: 1.5px dotted var(--line-strong);
  }

  /* ---------- gökyüzüm ---------- */
  .skyhead {
    position: absolute;
    top: calc(env(safe-area-inset-top, 0px) + 96px);
    left: max(28px, env(safe-area-inset-left, 0px));
    max-width: min(400px, calc(100% - 32px));
    pointer-events: auto;
    /* yazı yörünge çizgilerinin üstünde de okunsun */
    text-shadow:
      0 0 14px var(--bg),
      0 0 26px var(--bg);
  }
  .skyhead .eyebrow {
    text-shadow: none;
  }
  .skyhead h2 {
    font-size: clamp(30px, 3.8vw, 46px);
  }
  .skyhead p {
    margin: 0;
    color: var(--muted);
  }
  .legend {
    list-style: none;
    display: flex;
    gap: 16px;
    margin: 16px 0 0;
    padding: 0;
    font: 500 11px var(--mono);
    color: var(--muted);
    text-shadow: none;
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 10px;
    border-radius: 999px;
    background: var(--chip);
    border: 1px solid var(--edge);
  }
  .lg-planet {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff, var(--tone) 70%);
  }
  .lg-star {
    width: 9px;
    height: 9px;
    background: var(--star);
    rotate: 45deg;
    border-radius: 2px;
  }

  /* ---------- bana ulaşın ---------- */
  .links {
    display: grid;
    gap: 8px;
    margin-top: 14px;
  }
  .links a {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: 12px;
    padding: 11px 14px 11px 11px;
    border-radius: 18px;
    background: var(--inset);
    border: 1px solid var(--line);
    box-shadow: inset 0 1px 0 var(--hi);
    text-decoration: none;
    transition:
      translate 0.3s var(--spring),
      border-color 0.3s,
      background-color 0.3s;
  }
  .links a i {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    font: 500 12px var(--mono);
    font-style: normal;
    color: var(--ink-fixed);
    background: color-mix(in srgb, var(--tone) 45%, #fff);
    border: 1.5px solid color-mix(in srgb, var(--tone) 75%, #fff);
    transition: rotate 0.4s var(--spring);
  }
  .links a i svg {
    width: 19px;
    height: 19px;
    display: block;
  }
  .links a b {
    font-weight: 700;
  }
  .links a span {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--muted);
  }
  .links a em {
    font-style: normal;
    color: var(--muted);
    transition:
      translate 0.3s var(--spring),
      color 0.3s;
  }
  .links a:hover,
  .links a:focus-visible {
    translate: 4px 0;
    border-color: color-mix(in srgb, var(--tone) 70%, transparent);
  }
  .links a:hover i {
    rotate: -8deg;
  }
  .links a:hover em {
    translate: 3px -3px;
    color: var(--accent);
  }
  .foot {
    margin-top: 18px !important;
    font: 600 19px/1.2 var(--hand);
    color: var(--muted);
    rotate: -1.5deg;
  }

  /* ---------- JS varken: yazılar sayfayla kaymaz, yerinde durur ve bölüm değişince yumuşakça yer değiştirir ---------- */
  :global(.anim) .hero,
  :global(.anim) .panel,
  :global(.anim) .skyhead {
    position: fixed;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    translate: 0 calc(var(--dir, 1) * -26px);
    filter: blur(6px);
    transition:
      opacity 0.32s ease,
      translate 0.4s cubic-bezier(0.5, 0, 0.8, 0.4),
      filter 0.32s ease,
      visibility 0s 0.4s;
  }
  :global(.anim) :global(section.in) .hero,
  :global(.anim) :global(section.in) .panel,
  :global(.anim) :global(section.in) .skyhead {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    translate: 0 0;
    filter: none;
    transition:
      opacity 0.7s ease 0.28s,
      translate 0.95s cubic-bezier(0.16, 0.9, 0.24, 1) 0.28s,
      filter 0.6s ease 0.28s,
      visibility 0s;
  }
  /* yeni gelen kart, gidilen yönün tersinden girer */
  :global(.anim) :global(section.pre) .hero,
  :global(.anim) :global(section.pre) .panel,
  :global(.anim) :global(section.pre) .skyhead {
    translate: 0 calc(var(--dir, 1) * 34px);
    transition: none;
  }
  :global(.anim) .hero {
    pointer-events: none !important;
  }
  /* kartın içindekiler sırayla belirir */
  :global(.anim) .panel-in > *,
  :global(.anim) .skyhead > * {
    opacity: 0;
    translate: 0 14px;
    transition:
      opacity 0.3s ease,
      translate 0.3s ease;
  }
  :global(.anim) :global(section.in) .panel-in > *,
  :global(.anim) :global(section.in) .skyhead > * {
    opacity: 1;
    translate: 0 0;
    transition:
      opacity 0.6s ease calc(var(--k, 0) * 70ms + 0.42s),
      translate 0.8s cubic-bezier(0.16, 0.9, 0.24, 1) calc(var(--k, 0) * 70ms + 0.42s);
  }

  /* ---------- bölüm çubuğu: alt ortada küçük gezegenler ---------- */
  .rail {
    position: fixed;
    z-index: 10;
    left: 50%;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 20px);
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px;
    border-radius: 999px;
    background: var(--chip);
    border: 1px solid var(--edge);
    box-shadow: var(--clay-sm);
    backdrop-filter: blur(12px);
  }
  .rail a {
    display: inline-flex;
    align-items: center;
    gap: 0;
    height: 30px;
    padding: 0 9px;
    border-radius: 999px;
    text-decoration: none;
    font: 500 11px var(--mono);
    letter-spacing: 0.04em;
    color: var(--fg);
    transition:
      background-color 0.4s,
      gap 0.5s var(--soft),
      padding 0.5s var(--soft);
  }
  .rail a i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff, var(--tone) 65%);
    box-shadow: 0 2px 4px -1px color-mix(in srgb, var(--tone) 70%, #302030);
    opacity: 0.55;
    transition:
      opacity 0.3s,
      scale 0.45s var(--spring);
  }
  .rail a span {
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    transition:
      max-width 0.55s var(--soft),
      opacity 0.35s;
  }
  .rail a:hover i,
  .rail a:focus-visible i {
    opacity: 1;
    scale: 1.25;
  }
  .rail a:global(.on) {
    gap: 8px;
    padding: 0 13px 0 9px;
    background: color-mix(in srgb, var(--tone) 24%, transparent);
  }
  .rail a:global(.on) i {
    opacity: 1;
    scale: 1.1;
  }
  .rail a:global(.on) span {
    max-width: 130px;
    opacity: 1;
  }

  /* ---------- gezegenin yazıları ---------- */
  .drawer {
    --tone: var(--accent);
    position: fixed;
    z-index: 8;
    right: max(22px, env(safe-area-inset-right, 0px));
    top: 50%;
    width: min(380px, calc(100% - 32px));
    max-height: min(78vh, calc(100svh - 150px));
    display: flex;
    flex-direction: column;
    overflow: hidden;
    translate: calc(100% + 60px) -50%;
    rotate: 3deg;
    opacity: 0;
    transition:
      translate 0.7s cubic-bezier(0.16, 0.9, 0.24, 1),
      rotate 0.7s cubic-bezier(0.16, 0.9, 0.24, 1),
      opacity 0.35s ease;
    color: var(--fg);
    background: var(--card);
    border: 1.5px solid var(--edge);
    border-radius: 28px;
    padding: 24px 22px 22px;
    backdrop-filter: blur(18px) saturate(1.15);
    box-shadow: var(--clay);
  }
  .drawer:global(.open) {
    translate: 0 -50%;
    rotate: 0deg;
    opacity: 1;
  }
  .close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 34px;
    height: 34px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--inset);
    color: var(--fg);
    cursor: pointer;
    transition:
      rotate 0.35s var(--spring),
      color 0.2s,
      border-color 0.2s;
  }
  .close:hover {
    rotate: 90deg;
    color: var(--accent);
    border-color: var(--accent);
  }
  /* yazı listesi kendi içinde kayar; gezinme düğmeleri hep görünür kalır */
  #drawer-body {
    flex: 1;
    min-height: 0;
    overflow: auto;
    scrollbar-width: thin;
